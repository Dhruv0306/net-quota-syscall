# Optional fragment for development: catches locking mistakes in
# kernel/net_quota.c (bh/irq lock misuse, sleeping in atomic context, bad
# timer use). Slows the kernel down; leave it out for the final demo build.
CONFIG_PROVE_LOCKING=y
CONFIG_DEBUG_ATOMIC_SLEEP=y
CONFIG_DEBUG_SPINLOCK=y
CONFIG_DEBUG_OBJECTS=y
CONFIG_DEBUG_OBJECTS_TIMERS=y
