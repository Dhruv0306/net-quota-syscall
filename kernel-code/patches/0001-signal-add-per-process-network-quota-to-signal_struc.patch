From 1423fda4eadb03c9d402b64351c0eea3f458d165 Mon Sep 17 00:00:00 2001
From: Dhruv Rakeshbhai Patel <dpatel5469@gmail.com>
Date: Mon, 19 Oct 2026 09:46:30 +0000
Subject: [PATCH 1/6] signal: add per-process network quota to signal_struct

Embed struct net_quota_info in signal_struct so that all threads of a
process share one network data quota and one byte counter.

Co-authored-by: Claude <noreply@anthropic.com>
---
 include/linux/sched/signal.h | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/include/linux/sched/signal.h b/include/linux/sched/signal.h
index d45a547..f46d90c 100644
--- a/include/linux/sched/signal.h
+++ b/include/linux/sched/signal.h
@@ -12,6 +12,7 @@
 #include <linux/pid.h>
 #include <linux/posix-timers.h>
 #include <linux/mm_types.h>
+#include <linux/net_quota.h>
 #include <asm/ptrace.h>
 
 /*
@@ -253,6 +254,9 @@ struct signal_struct {
 						 * and may have inconsistent
 						 * permissions.
 						 */
+
+	/* Network data quota of this process, see net_quota/net_quota.c */
+	struct net_quota_info net_quota;
 } __randomize_layout;
 
 /*
