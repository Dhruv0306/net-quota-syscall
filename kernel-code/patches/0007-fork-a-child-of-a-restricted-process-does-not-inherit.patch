From 6afbc282b093436aa02de4d80cd27fb3b8297e6d Mon Sep 17 00:00:00 2001
From: Dhruv Rakeshbhai Patel <dpatel5469@gmail.com>
Date: Thu, 22 Oct 2026 07:53:33 +0000
Subject: [PATCH] fork: a child of a restricted process does not inherit the
 quota

Stop calling net_quota_inherit() in copy_signal(): a child process starts
with no quota, no limit and no timer, whatever its parent has. The quota
stays with the process it was set on. Since no timer is armed at fork any
more, the cleanup that patch 0006 added to the fork failure path is not
needed and is removed again.

Co-authored-by: Claude <noreply@anthropic.com>
---
 kernel/fork.c | 6 +-----
 1 file changed, 1 insertion(+), 5 deletions(-)

diff --git a/kernel/fork.c b/kernel/fork.c
index 2b15ad3..072805c 100644
--- a/kernel/fork.c
+++ b/kernel/fork.c
@@ -1773,7 +1773,6 @@ static int copy_signal(u64 clone_flags, struct task_struct *tsk)
 	init_rwsem(&sig->exec_update_lock);
 
 	net_quota_init(&sig->net_quota);
-	net_quota_inherit(&sig->net_quota, &current->signal->net_quota);
 
 	return 0;
 }
@@ -2594,11 +2593,8 @@ bad_fork_cleanup_mm:
 		mmput(p->mm);
 	}
 bad_fork_cleanup_signal:
-	if (!(clone_flags & CLONE_THREAD)) {
-		/* An inherited network quota has its timer running: stop it first. */
-		net_quota_exit(&p->signal->net_quota);
+	if (!(clone_flags & CLONE_THREAD))
 		free_signal_struct(p->signal);
-	}
 bad_fork_cleanup_sighand:
 	__cleanup_sighand(p->sighand);
 bad_fork_cleanup_fs:
