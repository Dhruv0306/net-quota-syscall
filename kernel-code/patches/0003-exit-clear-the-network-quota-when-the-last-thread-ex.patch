From 00f2070a9bdfacb229ebd41c35d6982ff535a961 Mon Sep 17 00:00:00 2001
From: "Claude (AI-assisted)" <noreply@anthropic.com>
Date: Mon, 19 Oct 2026 06:09:41 +0000
Subject: [PATCH 3/5] exit: clear the network quota when the last thread exits

Stop the expiry timer and drop the quota, so that nothing outlives the
process and a reused PID starts without a limit.
---
 kernel/exit.c | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/kernel/exit.c b/kernel/exit.c
index 27e5cf8..7c79b9a 100644
--- a/kernel/exit.c
+++ b/kernel/exit.c
@@ -71,6 +71,7 @@
 #include <linux/unwind_deferred.h>
 #include <linux/uaccess.h>
 #include <linux/pidfs.h>
+#include <linux/net_quota.h>
 
 #include <uapi/linux/wait.h>
 
@@ -945,6 +946,7 @@ void __noreturn do_exit(long code)
 		hrtimer_cancel(&tsk->signal->real_timer);
 		exit_itimers(tsk);
 #endif
+		net_quota_exit(&tsk->signal->net_quota);
 		if (tsk->mm)
 			setmax_mm_hiwater_rss(&tsk->signal->maxrss, tsk->mm);
 	}
