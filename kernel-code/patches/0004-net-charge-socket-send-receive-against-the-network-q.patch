From 0cf6023d522d162ae91d01d8921ce5a0aac8eabf Mon Sep 17 00:00:00 2001
From: "Claude (AI-assisted)" <noreply@anthropic.com>
Date: Mon, 19 Oct 2026 06:09:41 +0000
Subject: [PATCH 4/5] net: charge socket send/receive against the network quota

Hook the lowest common send and receive paths in net/socket.c:
sock_sendmsg_nosec() and sock_recvmsg_nosec(), which cover send, sendto,
sendmsg, sendmmsg, write, recv, recvfrom, recvmsg, recvmmsg, read,
sendfile and io_uring socket operations. Receive-side splice calls the
protocol's splice_read directly, so sock_splice_read() is hooked as well.
---
 net/socket.c | 41 +++++++++++++++++++++++++++++++++--------
 1 file changed, 33 insertions(+), 8 deletions(-)

diff --git a/net/socket.c b/net/socket.c
index 63c69a0..bfc460a 100644
--- a/net/socket.c
+++ b/net/socket.c
@@ -110,6 +110,7 @@
 #include <linux/errqueue.h>
 #include <linux/ptp_clock_kernel.h>
 #include <trace/events/sock.h>
+#include <net/net_quota.h>
 
 #include "core/dev.h"
 
@@ -772,13 +773,21 @@ static noinline void call_trace_sock_send_length(struct sock *sk, int ret,
 
 static inline int sock_sendmsg_nosec(struct socket *sock, struct msghdr *msg)
 {
-	int ret = INDIRECT_CALL_INET(READ_ONCE(sock->ops)->sendmsg, inet6_sendmsg,
-				     inet_sendmsg, sock, msg,
-				     msg_data_left(msg));
+	struct net_quota_ticket nqt;
+	int ret;
+
+	ret = net_quota_begin(sock, msg, NQ_DIR_SEND, 0, &nqt);
+	if (ret)
+		return ret;
+
+	ret = INDIRECT_CALL_INET(READ_ONCE(sock->ops)->sendmsg, inet6_sendmsg,
+				 inet_sendmsg, sock, msg,
+				 msg_data_left(msg));
 	BUG_ON(ret == -EIOCBQUEUED);
 
 	if (trace_sock_send_length_enabled())
 		call_trace_sock_send_length(sock->sk, ret, 0);
+	net_quota_end(&nqt, msg, ret);
 	return ret;
 }
 
@@ -1123,12 +1132,20 @@ static noinline void call_trace_sock_recv_length(struct sock *sk, int ret, int f
 static inline int sock_recvmsg_nosec(struct socket *sock, struct msghdr *msg,
 				     int flags)
 {
-	int ret = INDIRECT_CALL_INET(READ_ONCE(sock->ops)->recvmsg,
-				     inet6_recvmsg,
-				     inet_recvmsg, sock, msg,
-				     msg_data_left(msg), flags);
+	struct net_quota_ticket nqt;
+	int ret;
+
+	ret = net_quota_begin(sock, msg, NQ_DIR_RECV, flags, &nqt);
+	if (ret)
+		return ret;
+
+	ret = INDIRECT_CALL_INET(READ_ONCE(sock->ops)->recvmsg,
+				 inet6_recvmsg,
+				 inet_recvmsg, sock, msg,
+				 msg_data_left(msg), flags);
 	if (trace_sock_recv_length_enabled())
 		call_trace_sock_recv_length(sock->sk, ret, flags);
+	net_quota_end(&nqt, msg, ret);
 	return ret;
 }
 
@@ -1180,12 +1197,20 @@ static ssize_t sock_splice_read(struct file *file, loff_t *ppos,
 {
 	struct socket *sock = file->private_data;
 	const struct proto_ops *ops;
+	struct net_quota_ticket nqt;
+	ssize_t ret;
 
 	ops = READ_ONCE(sock->ops);
+	/* copy_splice_read() ends up in sock_read_iter(), which is hooked. */
 	if (unlikely(!ops->splice_read))
 		return copy_splice_read(file, ppos, pipe, len, flags);
 
-	return ops->splice_read(sock, ppos, pipe, len, flags);
+	ret = net_quota_begin_len(sock, &len, NQ_DIR_RECV, 0, &nqt);
+	if (ret)
+		return ret;
+	ret = ops->splice_read(sock, ppos, pipe, len, flags);
+	net_quota_end_len(&nqt, ret);
+	return ret;
 }
 
 static void sock_splice_eof(struct file *file)
