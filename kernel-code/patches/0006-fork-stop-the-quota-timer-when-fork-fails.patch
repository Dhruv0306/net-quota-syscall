From 789b84869c1ed85cac26152f428d2dc4b891504e Mon Sep 17 00:00:00 2001
From: Dhruv Rakeshbhai Patel <dpatel5469@gmail.com>
Date: Thu, 22 Oct 2026 02:11:42 +0000
Subject: [PATCH] fork: stop the quota timer when fork() fails

The timer of an inherited network quota is armed in copy_signal(), when the
limit is set for the child. If copy_process() fails afterwards, the child's
signal_struct is freed without any process having exited, so the timer would
still be pending and fire on freed memory. Call net_quota_exit() before
free_signal_struct(), in process context, which stops the timer and clears
the quota.

Co-authored-by: Claude <noreply@anthropic.com>
---
 kernel/fork.c | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/kernel/fork.c b/kernel/fork.c
index 00e12ed..2b15ad3 100644
--- a/kernel/fork.c
+++ b/kernel/fork.c
@@ -2594,8 +2594,11 @@ bad_fork_cleanup_mm:
 		mmput(p->mm);
 	}
 bad_fork_cleanup_signal:
-	if (!(clone_flags & CLONE_THREAD))
+	if (!(clone_flags & CLONE_THREAD)) {
+		/* An inherited network quota has its timer running: stop it first. */
+		net_quota_exit(&p->signal->net_quota);
 		free_signal_struct(p->signal);
+	}
 bad_fork_cleanup_sighand:
 	__cleanup_sighand(p->sighand);
 bad_fork_cleanup_fs:
-- 
